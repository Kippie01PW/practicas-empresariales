@startuml
title ESC-04: Aprobar el acta electrónicamente (CU-10, PA-03, RN-02, RN-03, ADR-005, ADR-006, ADR-008)

autonumber

actor "Docente asesor" as doc
actor "Coordinador de prácticas" as coord
participant "Aplicación web" as web
participant "API de prácticas" as api
participant "SSO Institucional" as sso
database "PostgreSQL" as db
database "Repositorio de actas PDF" as pdfrepo
queue "Broker de mensajes" as broker
participant "Worker de integración" as worker
participant "Servicio de correo" as correo

== Paso 1: Aprobación electrónica del Docente asesor ==

doc -> web : Firma electrónicamente el acta final [HTTPS]
activate web

web -> api : Solicita registrar firma de docente [POST /actas/{id}/aprobar JSON/HTTPS]
activate api

api -> sso : Valida identidad institucional [OIDC/HTTPS]
activate sso
sso --> api : Identidad verificada (Docente asesor)
deactivate sso

api -> api : Autorizador RBAC valida rol y asignación de práctica (ADR-005)

api -> db : Consulta ActaFinal y Practica [SQL]
activate db
db --> api : Datos del ActaFinal (hashIntegridadSha256)
deactivate db

api -> pdfrepo : Lee binario PDF para verificar integridad [I/O Disco]
activate pdfrepo
pdfrepo --> api : Binario PDF
deactivate pdfrepo

api -> api : Recalcula SHA-256 y comprueba que coincide con hashIntegridadSha256 (ADR-008)

api -> db : Actualiza ActaFinal (aprobadaPorDocente = true) e inserta EventoBitacora Append-Only [SQL]
activate db
db --> api : Transacción atómica confirmada (ADR-006)
deactivate db

api --> web : 200 OK (Aprobación de docente registrada)
deactivate api
web --> doc : Confirma firma electrónica del docente
deactivate web

== Paso 2: Aprobación electrónica final del Coordinador de prácticas ==

coord -> web : Revisa y aprueba electrónicamente el acta final [HTTPS]
activate web

web -> api : Solicita registrar firma de coordinador [POST /actas/{id}/aprobar JSON/HTTPS]
activate api

api -> sso : Valida identidad institucional [OIDC/HTTPS]
activate sso
sso --> api : Identidad verificada (Coordinador de prácticas)
deactivate sso

api -> api : Autorizador RBAC valida rol = Coordinador de prácticas (ADR-005)

break [ActaFinal.aprobadaPorDocente == false - RN-02]
    api --> web : 409 Conflict (Falta firma previa del Docente asesor - ADR-010)
    web --> coord : Notifica que el docente asesor aún no ha firmado el acta
end

api -> db : Actualiza ActaFinal (aprobadaPorCoordinador = true), transiciona Practica\n(Evaluada -> Completada, ADR-010) e inserta EventoBitacora inmutable [SQL]
activate db
db --> api : Transacción confirmada
deactivate db

api ->> broker : Publica evento "ActaFinalEmitida" (id_practica, rutaArchivoPdf) [AMQP]

api --> web : 200 OK (Práctica Completada y Acta en firme)
deactivate api
web --> coord : Muestra confirmación y enlace de descarga del acta oficial
deactivate web

broker ->> worker : Entrega evento "ActaFinalEmitida" [AMQP]
activate worker
worker -> correo : Envía notificación y acta final en PDF al Estudiante (OB-05) [SMTP/TLS]
activate correo
correo --> worker : Correo entregado
deactivate correo
deactivate worker
@enduml
